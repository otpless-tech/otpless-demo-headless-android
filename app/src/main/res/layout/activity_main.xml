<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:name="com.otpless.demo.otplessheadlessdemo.HomeScreen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Event log console: mirrors every OtplessSDK callback so the callback stream
         is visible on-screen across all fragments, not just in adb logcat. Collapsed
         by default; the header row toggles it open, "Clear" wipes it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/log_console_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/log_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Event log  ▸"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="12sp"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/log_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear"
                android:textColor="@color/custom_error"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/log_scroll"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="10.5sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/log_console_text"
                android:paddingHorizontal="10dp"
                android:paddingBottom="12dp"
                android:text="" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
